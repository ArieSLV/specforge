<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Specforge.Tests</RootNamespace>
    <AssemblyName>Specforge.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- DEC-003: Tests depends on both projects. Core is the assembly the boundary test scans;
         Mcp is exercised in-proc (no real stdio handshake) for tool tests. -->
    <ProjectReference Include="..\..\src\Specforge.Core\Specforge.Core.csproj" />
    <ProjectReference Include="..\..\src\Specforge.Mcp\Specforge.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ITEM-004 skill-catalog test fixtures. Embedded under distinct test.skills.* prefixes so each
         scenario (valid / broken / name-mismatch) can be enumerated in isolation; never collides with
         the production specforge.skills/ prefix. -->
    <EmbeddedResource Include="SkillFixtures\valid-skill\SKILL.md">
      <LogicalName>test.skills.valid/valid-skill/SKILL.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="SkillFixtures\broken-skill\SKILL.md">
      <LogicalName>test.skills.broken/broken-skill/SKILL.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="SkillFixtures\name-mismatch\SKILL.md">
      <LogicalName>test.skills.mismatch/name-mismatch/SKILL.md</LogicalName>
    </EmbeddedResource>
    <!-- Backslash in the logical name mimics MSBuild %(RecursiveDir) on Windows; the catalog must
         normalize it. Distinct physical file (NETSDK1022 forbids embedding one file twice). -->
    <EmbeddedResource Include="SkillFixtures\winpath\SKILL.md">
      <LogicalName>test.skills.winpath/winpath\SKILL.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
