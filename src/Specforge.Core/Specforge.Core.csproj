<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Specforge.Core</RootNamespace>
    <AssemblyName>Specforge.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- DEC-003: Core depends only on BCL + Markdig + YamlDotNet + Logging.Abstractions. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- YamlDotNet: SKILL.md frontmatter parsing (ITEM-004, DEC-005). -->
    <PackageReference Include="YamlDotNet" />
    <!-- Markdig: decision/item document section parsing (ITEM-007, DEC-003). -->
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <!-- DEC-005 build-time embedding: every file under spec/skills/** ships inside Specforge.Core.dll.
         The .gitkeep directory anchor is excluded (and also filtered at enumeration time). -->
    <EmbeddedResource Include="..\..\spec\skills\**\*.*" Exclude="..\..\spec\skills\**\.gitkeep">
      <LogicalName>specforge.skills/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- DEC-008 / ITEM-006: embed canonical shared docs + templates for scaffold mode. Scoped tightly
         so they never double-embed spec/skills/**. -->
    <EmbeddedResource Include="..\..\spec\shared\**\*.*" Exclude="..\..\spec\shared\**\.gitkeep">
      <LogicalName>specforge.shared/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\spec\templates\**\*.*" Exclude="..\..\spec\templates\**\.gitkeep">
      <LogicalName>specforge.templates/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
