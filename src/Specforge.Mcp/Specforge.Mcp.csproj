<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>specforge</AssemblyName>
    <RootNamespace>Specforge.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Specforge.Core\Specforge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DEC-003: Mcp = Core + official MCP C# SDK + stderr console logging + DI.
         ModelContextProtocol.Core is the low-level surface (no Microsoft.Extensions.Hosting),
         matching ITEM-002's manual DI + stdio-host wiring. -->
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
